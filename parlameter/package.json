    "eslint-plugin-import": "^2.25.2",
    "parcel": "^2.14.2",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "rimraf": "^6.0.1",
    "sass": "^1.86.0",
    "static-i18n": "^0.2.10",
    "svgo": "^3.3.3"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "replaceme": "git+https://github.com/adrianklimek/replaceme.git#40e51929cda5ca94ea99273fa9484e224211f524"
